{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://geniekit.dev/schemas/story.schema.json",
  "title": "Interactive Film Game Story Schema",
  "description": "JSON Schema for IFG (Interactive Film Game) story.json - the data contract between data producers and the React engine",
  "type": "object",
  "required": ["meta", "nodes"],
  "properties": {
    "meta": {
      "type": "object",
      "description": "作品元信息",
      "required": ["title", "version", "start"],
      "properties": {
        "title": { "type": "string", "description": "作品标题，兼作存档命名空间 key" },
        "version": { "type": "string", "description": "数据版本号" },
        "start": { "type": "string", "description": "入口节点 id，必须存在于 nodes 中" }
      }
    },
    "config": {
      "type": "object",
      "description": "故事级全局配置（可选）",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "locale": {
          "type": "string",
          "description": "引擎 UI 语言（按钮/面板/结局标签等）；未指定时使用中文，zh 及其地区变体使用中文，其他语言使用英文。剧情文案本身不受此字段影响"
        },
        "poster": { "$ref": "#/definitions/HttpUrl", "description": "封面图或视频 URL" },
        "titleAlign": { "type": "string", "enum": ["left", "center", "right"], "description": "封面标题对齐" },
        "components": {
          "type": "object",
          "description": "按使用位置配置 Miora 展示组件；未配置的位置使用引擎默认值",
          "additionalProperties": false,
          "properties": {
            "titleMenu": { "$ref": "#/definitions/GameMenuRef" },
            "titleMenuButton": { "$ref": "#/definitions/GameMenuButtonRef" },
            "choiceGroup": { "$ref": "#/definitions/GameChoiceGroupRef" },
            "choiceButton": { "$ref": "#/definitions/GameMenuButtonRef" },
            "loadingProgress": { "$ref": "#/definitions/GameProgressBarRef" },
            "storyTree": { "$ref": "#/definitions/GameLevelGroupRef" },
            "storyTreeProgress": {
              "oneOf": [
                { "$ref": "#/definitions/GameProgressInfoRef" },
                { "$ref": "#/definitions/GameProgressBarRef" }
              ]
            },
            "actionButton": { "$ref": "#/definitions/GameMenuButtonRef" },
            "endingCard": { "$ref": "#/definitions/GameEndingCardRef" },
            "screen": { "$ref": "#/definitions/GameScreenRef" },
            "text": { "$ref": "#/definitions/GameTextRef" }
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["light", "dark"] },
            "game": { "type": "string", "enum": ["ancient", "default"], "description": "Miora 全局主题；组件 props.theme 优先，不从 preset 推导" },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "preset": {
              "type": "string",
              "enum": ["minimal", "horror", "scifi", "fantasy", "romance"],
              "description": "成套游戏风格主题：一行整体换皮（选项/道具/文字/HUD/结局卡）。不填落 minimal 兜底"
            }
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "textSpeed": { "type": "string", "enum": ["slow", "normal", "fast", "instant"] }
          }
        },
        "audio": {
          "type": "object",
          "properties": {
            "bgm": { "$ref": "#/definitions/HttpUrl" },
            "bgmVolume": { "type": "number", "minimum": 0, "maximum": 1 },
            "sfxVolume": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "features": {
          "type": "object",
          "properties": {
            "backlog": { "type": "boolean" },
            "gallery": { "type": "boolean" },
            "inventory": { "type": "boolean" },
            "autosave": { "type": "boolean" },
            "saveSlots": { "type": "integer", "minimum": 1 },
            "showQuestion": { "type": "boolean", "description": "是否显示选项问题文案，缺省 true" },
            "loopByDefault": { "type": "boolean", "description": "无显式 loop 的节点是否默认循环，缺省 false" }
          }
        },
        "skin": {
          "type": "object",
          "properties": {
            "choiceStyle": { "type": "string", "enum": ["plain", "ribbon", "plaque"] },
            "frame": { "$ref": "#/definitions/HttpUrl", "description": "全局共享装饰底图 URL" },
            "font": { "type": "string", "enum": ["sans", "serif"] },
            "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "motion": {
          "type": "object",
          "properties": {
            "transition": {
              "type": "string",
              "enum": ["fade", "fade-black", "fade-white", "slide-up", "slide-down", "slide-left", "slide-right", "zoom", "blur", "dissolve", "glitch", "ripple", "none"]
            },
            "choiceReveal": {
              "type": "string",
              "enum": ["stagger-fade", "slide-up", "scale-in", "typewriter", "glow-pulse"]
            },
            "textStyle": { "type": "string", "enum": ["banner", "bubble", "centered"] },
            "intensity": { "type": "string", "enum": ["subtle", "normal", "cinematic"] },
            "reducedMotion": { "type": "string", "enum": ["auto", "on", "off"] }
          }
        }
      }
    },
    "variables": {
      "type": "object",
      "description": "状态变量初值。key 为变量名，value 为初值",
      "additionalProperties": {
        "type": ["boolean", "number", "string"]
      }
    },
    "items": {
      "type": "array",
      "description": "道具库",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "image": { "$ref": "#/definitions/HttpUrl", "description": "道具图 URL（可选）" }
        }
      }
    },
    "characters": {
      "type": "array",
      "description": "角色库",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "image": { "$ref": "#/definitions/HttpUrl", "description": "角色参考图 URL（可选）" }
        }
      }
    },
    "nodes": {
      "type": "object",
      "description": "剧情节点字典。key 为节点 id，value 为节点对象",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/Node"
      }
    },
    "qte": { "$ref": "#/definitions/QteLibRef", "description": "QTE 组件库整体引用（含 QTE 交互时必填）" }
  },
  "definitions": {
    "UiComponentVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "description": "组件库精确 SemVer 版本，支持预发布和构建标识；同一故事的展示组件与 QTE 使用同一整库版本"
    },
    "UiComponentStyle": {
      "type": "object",
      "description": "React 内联样式与 Miora CSS 自定义变量，值为字符串或数字",
      "additionalProperties": { "type": ["string", "number"] }
    },
    "GameMenuRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameMenu" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" },
            "place": { "type": "string", "enum": ["left", "right", "bottom"] }
          }
        }
      }
    },
    "GameMenuButtonRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameMenuButton" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" },
            "variant": { "type": "string", "enum": ["default", "cover", "secondary"] }
          }
        }
      }
    },
    "GameChoiceGroupRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameChoiceGroup" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" }
          }
        }
      }
    },
    "GameProgressBarRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameProgressBar" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" },
            "variant": { "type": "string", "enum": ["default", "loading"] }
          }
        }
      }
    },
    "GameLevelGroupRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameLevelGroup" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" },
            "rows": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "GameEndingCardRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameEndingCard" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" }
          }
        }
      }
    },
    "GameProgressInfoRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameProgressInfo" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" }
          }
        }
      }
    },
    "GameScreenRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameScreen" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" },
            "blur": { "type": "boolean" },
            "blurRadius": { "type": "number" }
          }
        }
      }
    },
    "GameTextRef": {
      "type": "object",
      "required": ["key", "version"],
      "additionalProperties": false,
      "properties": {
        "key": { "const": "GameText" },
        "version": { "$ref": "#/definitions/UiComponentVersion" },
        "props": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "className": { "type": "string" },
            "theme": { "type": "string", "enum": ["ancient", "default"] },
            "style": { "$ref": "#/definitions/UiComponentStyle" },
            "size": { "oneOf": [{ "type": "string", "enum": ["xs", "sm", "md", "lg", "xl"] }, { "type": "number" }] },
            "tone": { "type": "string", "enum": ["title", "body", "fail", "weak"] }
          }
        }
      }
    },
    "HttpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^[Hh][Tt][Tt][Pp][Ss]?://",
      "description": "可公开访问的 HTTP(S) URL"
    },
    "Point": {
      "type": "object",
      "required": ["x", "y"],
      "description": "相对媒体框的归一化坐标（0~1）",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "Region": {
      "type": "object",
      "required": ["x", "y", "w", "h"],
      "description": "相对媒体框的归一化矩形区域（0~1）",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" }
      }
    },
    "QteLibRef": {
      "type": "object",
      "required": ["lib", "version"],
      "description": "QTE 组件库整体引用（story 级）。整库按 version 整体安装/更新，节点只按 name 引用组件",
      "properties": {
        "lib": { "type": "string", "description": "组件库包名，如 miora-spell" },
        "version": { "type": "string", "description": "整库版本（story 权威，生成期对账据此整体安装/更新）" }
      }
    },
    "QteComponentRef": {
      "type": "object",
      "description": "QTE 组件引用（远端统一库 miora-spell）。上游终态用 key(库控件类名) 引用；旧写法用 name(逻辑短名)。二者其一即可（由 validate 语义校验保证可解析）",
      "properties": {
        "key": { "type": "string", "description": "库控件类名（GameClickControl/GameComboControl/GameHoldControl/GameSlideControl），上游终态字段" },
        "name": { "type": "string", "description": "逻辑短名（click/combo/hold/slide），本仓库旧写法；与 key 二选一" },
        "version": { "type": "string", "description": "组件/整库版本；story.qte.version 缺省时以此为准，由生成期对账据此安装/更新" },
        "props": { "type": "object", "description": "玩法参数（含 prompt 等），props 深校验由 CCR propsSchema 承担" },
        "degraded": { "type": "boolean", "description": "仅由生成期对账写入：无法满足时置真 → 运行时直接 FallbackQte" }
      }
    },
    "Condition": {
      "description": "结构化条件（引擎可安全求值）。叶子为比较 / has / visited，可用 and/or/not 递归组合",
      "type": "object",
      "oneOf": [
        {
          "required": ["op", "var", "value"],
          "properties": {
            "op": { "type": "string", "enum": [">=", ">", "<=", "<", "==", "!="] },
            "var": { "type": "string" },
            "value": { "type": ["boolean", "number", "string"] }
          }
        },
        {
          "required": ["op", "item"],
          "properties": {
            "op": { "const": "has" },
            "item": { "type": "string" }
          }
        },
        {
          "required": ["op", "node"],
          "properties": {
            "op": { "const": "visited" },
            "node": { "type": "string" }
          }
        },
        {
          "required": ["and"],
          "properties": { "and": { "type": "array", "items": { "$ref": "#/definitions/Condition" } } }
        },
        {
          "required": ["or"],
          "properties": { "or": { "type": "array", "items": { "$ref": "#/definitions/Condition" } } }
        },
        {
          "required": ["not"],
          "properties": { "not": { "$ref": "#/definitions/Condition" } }
        }
      ]
    },
    "Effect": {
      "description": "状态变更（op 结构）：set/inc/dec 作用于变量，add/remove 作用于道具",
      "type": "object",
      "oneOf": [
        {
          "required": ["op", "var", "value"],
          "properties": {
            "op": { "const": "set" },
            "var": { "type": "string" },
            "value": { "type": ["boolean", "number", "string"] }
          }
        },
        {
          "required": ["op", "var"],
          "properties": {
            "op": { "type": "string", "enum": ["inc", "dec"] },
            "var": { "type": "string" },
            "value": { "type": "number", "description": "增减量，缺省 1" }
          }
        },
        {
          "required": ["op", "item"],
          "properties": {
            "op": { "type": "string", "enum": ["add", "remove"] },
            "item": { "type": "string" }
          }
        }
      ]
    },
    "Media": {
      "description": "节点媒体：单视频或多段序列",
      "$comment": "validate.py validate_media 依赖此定义做 URL 语义校验；变更时需同步校验器、参考文档和测试",
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "src"],
          "properties": {
            "type": { "const": "video" },
            "src": { "$ref": "#/definitions/HttpUrl" },
            "subtitle": { "$ref": "#/definitions/HttpUrl" }
          }
        },
        {
          "type": "object",
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "sequence" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["src"],
                "properties": {
                  "src": { "$ref": "#/definitions/HttpUrl" },
                  "shotId": { "type": "string" },
                  "subtitle": { "$ref": "#/definitions/HttpUrl" },
                  "poster": { "$ref": "#/definitions/HttpUrl", "description": "镜头首帧图片；节点未指定 cover 时，剧情树使用第一项的 poster" }
                }
              }
            }
          }
        }
      ]
    },
    "Choice": {
      "type": "object",
      "required": ["label", "next"],
      "properties": {
        "label": { "type": "string", "description": "选项显示文字" },
        "next": { "type": "string", "description": "选中后跳转的节点 id" },
        "condition": { "$ref": "#/definitions/Condition" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/Effect" }
        },
        "skin": { "type": "string", "enum": ["plain", "ribbon", "plaque"], "description": "overlay 选项皮肤（覆盖 config.skin.choiceStyle）" },
        "art": { "$ref": "#/definitions/HttpUrl", "description": "overlay 选项专属装饰底图 URL" },
        "hint": { "type": "boolean", "description": "hotspots 是否显示可见提示" },
        "anchor": { "$ref": "#/definitions/Point" },
        "region": { "$ref": "#/definitions/Region" }
      }
    },
    "Node": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["start", "scene", "choice", "ending", "interaction", "click", "combo", "hold", "direction"]
        },
        "title": { "type": "string", "description": "节点标题，用于剧情树和结局展示" },
        "cover": { "$ref": "#/definitions/HttpUrl", "description": "剧情树和结局卡的封面图片" },
        "text": { "type": "string" },
        "media": { "$ref": "#/definitions/Media" },
        "bgm": { "$ref": "#/definitions/HttpUrl" },
        "bgmLoop": { "type": "boolean", "description": "bgm 是否循环播放，缺省 true；false 时播完一遍即静音，直到下一个配了 bgm 的节点" },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/definitions/Effect" }
        },
        "next": { "type": "string" },
        "fail": { "type": "string", "description": "interaction 失败/超时跳转节点" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/definitions/Choice" }
        },
        "clipDuration": { "type": "number", "description": "节点视频总时长(ms)" },
        "choiceAt": { "type": "number", "description": "选项出现开始时间(ms)" },
        "choiceDuration": { "type": "number", "description": "选项显示持续时间(ms)" },
        "loop": { "type": "boolean", "description": "视频循环播放" },
        "transition": {
          "type": "string",
          "enum": ["fade", "fade-black", "fade-white", "slide-up", "slide-down", "slide-left", "slide-right", "zoom", "blur", "dissolve", "glitch", "ripple", "none"]
        },
        "textStyle": { "type": "string", "enum": ["banner", "bubble", "centered"] },
        "typewriter": { "type": "boolean", "description": "是否逐字打字机（默认 false，字幕整句直显）" },
        "speaker": { "type": "string" },
        "fx": {
          "type": "array",
          "items": { "type": "string" },
          "description": "节点触发的瞬时表现反馈列表：屏幕动效、设备振动，或 sfx:<http(s)音频URL>。不修改剧情状态"
        },
        "ending_type": { "type": "string", "enum": ["good", "bad", "hidden", "normal"] },
        "interaction": {
          "type": "string",
          "enum": ["tap", "longpress", "hold-release", "swipe", "drag", "rotate", "rapidtap", "rhythm", "trace", "hotspots"]
        },
        "onSuccess": { "type": "string", "description": "interaction 判定成功后跳转的节点 id（QTE 成败分支）" },
        "onFail": { "type": "string", "description": "interaction 判定失败/超时后跳转的节点 id（QTE 成败分支）" },
        "timeout": { "type": "number", "minimum": 0, "description": "interaction 判定限时(ms)，超时按 onFail 处理" },
        "prompt": { "type": "string", "description": "交互操作提示文案" },
        "duration": { "type": "number", "minimum": 0, "description": "longpress/hold-release 蓄力时长(ms)" },
        "window": { "type": "number", "minimum": 0, "description": "hold-release/rhythm 命中窗口(ms)" },
        "direction": { "type": "string", "enum": ["up", "down", "left", "right", "any"], "description": "swipe/drag 方向" },
        "target": { "$ref": "#/definitions/Point", "description": "drag 目标点（相对媒体框 0~1）" },
        "snap": { "type": "boolean", "description": "drag 是否吸附目标" },
        "angle": { "type": "number", "description": "rotate 目标角度(度)" },
        "tolerance": { "type": "number", "minimum": 0, "description": "rotate 角度容差 / drag/trace 命中半径" },
        "count": { "type": "number", "minimum": 1, "description": "rapidtap 需要次数" },
        "decay": { "type": "number", "minimum": 0, "description": "rapidtap 每帧衰减" },
        "beats": { "type": "array", "items": { "type": "number" }, "description": "rhythm 节拍时间点(ms)" },
        "points": { "type": "array", "items": { "$ref": "#/definitions/Point" }, "description": "trace 途经点（相对媒体框 0~1）" },
        "component": { "$ref": "#/definitions/QteComponentRef", "description": "QTE 组件引用（优先于内置 interaction）" },
        "rect": { "$ref": "#/definitions/Region", "description": "组件在媒体内容框内的子矩形（0~1），缺省铺满" },
        "appearAt": { "type": "number", "minimum": 0, "description": "组件浮现时机(秒)，缺省沿用 choiceAt/片段末尾" },
        "disappearAt": { "type": "number", "minimum": 0, "description": "组件消失时机(秒)，窗口内未完成→onFail" },
        "scale": { "description": "组件视觉缩放百分比，建议 50~200，缺省 100（不缩放）；非法值（非数/超范围）不报错，运行时回落 100；以 rect 框中心为原点" },
        "limited": { "type": "boolean", "description": "false=关闭判定限时：不超时判负、不展示倒计时（忽略 timeout 与 appearAt/disappearAt 的判负截止；appearAt 仍控制浮现时机；videoSpeed 随之整段生效，见该字段）；缺省/true 沿用现有限时逻辑" },
        "videoSpeed": {
          "description": "QTE 区间内的视频播放速率，档位 0.5/1/1.5/2，缺省 1（正常速度）。优先只在 appearAt~disappearAt 这段媒体时间内生效（左闭右开），区间前后一律原速；没有可用区间时退化成整段变速（整个节点按该速率播到结尾），并告警 QTE_SPEED_WHOLE_NODE——两种触发：缺 appearAt 或 disappearAt，以及 limited:false（判负截止被关掉、disappearAt 不再生效，两端齐备也按整段算）。要只在 QTE 区间内变速就必须写全两端且不写 limited:false。非法值（非档位/非数）不报错，运行时回落 1。仅对有自己 media 的节点生效。appearAt/disappearAt/clipDuration 仍按原始媒体时间填写；timeout 是玩家反应时间，不随速率变化"
        },
        "resultTransitionMode": {
          "type": "string",
          "enum": ["immediate", "afterVideoEnd"],
          "description": "QTE 得出成功/失败结果后的跳转时机，缺省 immediate（立即跳转）。afterVideoEnd=记录结果，待当前视频或完整视频序列播放结束后再跳转，需显式写出。节点无自有 media 或实际循环播放（node.loop 或 config.features.loopByDefault）时等不到视频结束，运行时回落 immediate"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "start" } } },
          "then": {
            "required": ["next"],
            "not": { "required": ["choices"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "scene" } } },
          "then": { "not": { "required": ["next", "choices"] } }
        },
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": {
            "required": ["choices"],
            "not": { "required": ["next"] }
          }
        },
        {
          "if": { "properties": { "type": { "const": "ending" } } },
          "then": {
            "required": ["ending_type"],
            "allOf": [
              { "not": { "required": ["next"] } },
              { "not": { "required": ["choices"] } }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "interaction" } } },
          "then": {}
        }
      ]
    }
  }
}
